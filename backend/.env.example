# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database (PostgreSQL — provided by `docker compose up` at the repo root;
# when the DB runs on your host, use localhost instead of the service name)
DATABASE_URL=postgresql+psycopg2://clarity:clarity@postgres:5432/clarity

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-production
DEV_AUTH_ALLOW_HEADER=True

# Azure / Foundry (REQUIRED — every agent calls the real service.
# Auth is Entra ID via DefaultAzureCredential: `az login` locally,
# Managed Identity on Azure. No keys.)
AZURE_FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_FOUNDRY_MODEL_DEPLOYMENT=gpt-4o-mini

# Foundry agent resource names (one deployed agent per Clarity agent)
PLANNER_AGENT=planner
QUESTION_GENERATOR_AGENT=question-generator
EVALUATOR_AGENT=evaluator
INTERVIEWER_AGENT=interviewer
COMPANY_INTEL_AGENT=company-intel
FOUNDRY_TIMEOUT_SECONDS=60
FOUNDRY_MAX_RETRIES=3

# Web research (Grounding with Bing Search). Attach the "Grounding with Bing
# Search" tool to this agent in your Foundry project (see docs/azure-setup.md).
# It searches the live web for company-specific OA problems + interview
# questions, on top of the company corpus. Empty name = CSV corpus only.
WEB_RESEARCH_AGENT=company-intel
WEB_RESEARCH_TTL_DAYS=14

# Foundry IQ / Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=clarity-corpus
AZURE_SEARCH_API_KEY=

# Blob
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=clarity
AZURE_STORAGE_CONNECTION_STRING=

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=

# External APIs
GITHUB_API_BASE_URL=https://api.github.com
CODEFORCES_API_BASE_URL=https://codeforces.com/api

# Google sign-in (optional; /auth/google/* returns 501 until set).
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# and add the redirect URI below to its authorized redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Per-company problem-frequency corpus (LeetCode-style CSV seed data).
# Resolved relative to the repo root by default.
COMPANY_CORPUS_DIR=../data/company-corpus/companies

# LeetCode pulls (docs/plans/plan-leetcode-pulls.md). Tokens are per-user,
# supplied in-app (onboarding / Settings), encrypted at rest with SECRET_BOX_KEY;
# only leetcode.com is ever called.
LEETCODE_GRAPHQL_URL=https://leetcode.com/graphql
LEETCODE_REQUEST_TIMEOUT=20
# Fernet key for encrypting user-supplied platform tokens. Empty = derived
# from JWT_SECRET (fine for dev; set explicitly in prod so JWT rotation
# doesn't invalidate stored cookies).
SECRET_BOX_KEY=
# Platform pulls re-sync rate limit (seconds between refreshes per user).
LEETCODE_REFRESH_MIN_INTERVAL=3600

# Judge0 self-hosted code execution (docs/plans/plan-judge0-judge.md).
# `docker compose up` at the repo root starts it (judge0-server on :2358);
# the compose file already injects this URL into the backend container.
# Empty URL = LocalJudge subprocess fallback (tests/dev, Python only).
JUDGE0_BASE_URL=http://judge0-server:2358
JUDGE0_AUTH_TOKEN=
JUDGE0_TIMEOUT_SECONDS=20
JUDGE0_POLL_INTERVAL=0.4

# Voice-to-voice interview — NOT read by the backend. The Gemini Live session
# runs entirely in the browser and needs VITE_GEMINI_API_KEY in
# frontend/.env.local (gitignored; see frontend/.env.example).
# GEMINI_API_KEY here is only a convenience mirror for reference/tooling.
# GEMINI_API_KEY=
