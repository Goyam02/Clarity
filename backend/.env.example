# Application
ENVIRONMENT=development
CLARITY_AI_MODE=mock
LOG_LEVEL=INFO

# Database (local default is sqlite; production: postgresql+psycopg2://user:pass@host:5432/clarity)
DATABASE_URL=sqlite:///./clarity.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-in-production
DEV_AUTH_ALLOW_HEADER=True

# Azure / Foundry (empty = mock-capable local dev; fill for azure mode)
AZURE_AI_PROJECT_ENDPOINT=
AZURE_FOUNDRY_PROJECT_ENDPOINT=
AZURE_FOUNDRY_MODEL=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Foundry Agent IDs (optional; used when Agent Service deployments exist)
PLANNER_AGENT_ID=
QUESTION_GENERATOR_AGENT_ID=
EVALUATOR_AGENT_ID=
INTERVIEWER_AGENT_ID=
COMPANY_INTEL_AGENT_ID=

# Foundry IQ / Search
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=clarity-corpus
AZURE_SEARCH_API_KEY=

# Blob
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_CONTAINER=clarity
AZURE_STORAGE_CONNECTION_STRING=

# Application Insights
APPLICATIONINSIGHTS_CONNECTION_STRING=

# External APIs
GITHUB_API_BASE_URL=https://api.github.com
CODEFORCES_API_BASE_URL=https://codeforces.com/api
