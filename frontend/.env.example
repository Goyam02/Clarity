# Gemini Live API — voice-to-voice interview (frontend only, see
# frontend/src/lib/geminiLive.ts and docs/plans/plan-livekit-voice-interview.md).
# Vite only exposes VITE_* variables to the browser client.
# Dev: set VITE_GEMINI_API_KEY in frontend/.env.local (gitignored).
# Prod: inject at build time.
VITE_GEMINI_API_KEY=

# Optional: override the Live model (default:
# gemini-2.5-flash-native-audio-preview-12-2025).
# VITE_GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# API base URL of the FastAPI backend (default http://localhost:8000; the
# Dockerized frontend reaches the backend through the nginx proxy instead).
# VITE_API_BASE_URL=http://localhost:8000
